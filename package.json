{
  "name": "quality-auditoria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx -r dotenv/config src/lib/db/migrate.ts",
    "build:desktop": "cross-env QUALITY_DESKTOP_PACKAGE=1 next build && node scripts/preparar-pacote-desktop.cjs",
    "desktop:dist": "npm run build:desktop && electron-builder --win nsis"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.8.0",
    "dotenv": "^17.4.2",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "br.com.qualityconsultorias.desktop",
    "protocols": [
      {
        "name": "Quality Desktop",
        "schemes": [
          "qualitydesktop"
        ]
      }
    ],
    "productName": "Quality Desktop",
    "directories": {
      "output": "dist-desktop/instaladores"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/setup.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-desktop/quality-server",
        "to": "quality-server"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true
  }
}
